VITE_APP_NAME = 'lightning' # 应用名称
VITE_UPDATE_URL= 'http://10.10.24.52:8089/electron-update' # 更新服务器URL，必须以 / 结尾
VITE_USE_MOCK = true #是否使用mock数据
