{
  "appId": "ichengzhou@icloud.com",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**"
  ],
  "productName": "lightning",
  "copyright": "Copyright © 2024 dyy.dongyuanwai",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "node_modules/**/*",
    "!**/node_modules/*/{CHANGELOG.md,CHANGELOG,changelog.md,CHANGELOG.txt}",
    "!**/node_modules/*/{README.md,README,readme.md,readme,Readme.md}",
    "!**/node_modules/*/{LICENSE,LICENSE.md,license.md,LICENCE,licence}",
    "!**/node_modules/*/{.eslintrc,.eslintrc.js,.eslintrc.json,.prettierrc}",
    "!**/node_modules/**/{test,tests,__tests__,spec,specs,__mocks__,jest,jest.config.*}/**",
    "!**/node_modules/**/{example,examples,demo,demos,sample,samples}/**",
    "!**/node_modules/**/{docs,doc,documentation,website,gh-pages,.github}/**",
    "!**/node_modules/**/*.{ts,d.ts,map,coffee,flow,gyp}",
    "!**/node_modules/**/.{travis.yml,nycrc,npmignore,gitignore,gitattributes,editorconfig}",
    "!**/node_modules/**/Makefile",
    "!**/node_modules/**/{.bin}/**",
    "!**/node_modules/**/*.{png,jpg,jpeg,gif,svg,bmp,ico,webp}",
    "!**/node_modules/**/{*.min.js.map,*.min.css.map}",
    "!**/node_modules/**/bench/**",
    "!**/node_modules/**/benchmark/**",
    "!**/node_modules/**/perf/**",
    "!**/node_modules/**/fixtures/**",
    "!**/node_modules/**/coverage/**",
    "!**/node_modules/**/CONTRIBUTING*",
    "!**/node_modules/**/HISTORY*",
    "!**/node_modules/**/AUTHORS*",
    "!**/node_modules/**/NOTICE*",
    "!**/node_modules/**/*.md",
    "!**/node_modules/**/*.txt",
    "!**/node_modules/**/package-lock.json",
    "!**/node_modules/**/yarn.lock",
    "!**/node_modules/**/.nyc_output/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/esbuild-*/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/eslint*/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/stylelint*/**",
    "!**/node_modules/postcss*/**",
    "!**/node_modules/sass/**",
    "!**/node_modules/sharp/**",
    "!**/node_modules/png-to-ico/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/vite-plugin-*/**",
    "!**/node_modules/unplugin-*/**",
    "!**/node_modules/vue-eslint-parser/**",
    "!**/node_modules/husky/**",
    "!**/node_modules/lint-staged/**",
    "!**/node_modules/@commitlint/**",
    "!**/node_modules/release-it/**",
    "!**/node_modules/@release-it/**",
    "!**/node_modules/conventional-changelog*/**",
    "!**/node_modules/inquirer/**",
    "!**/node_modules/directory-tree/**",
    "!**/node_modules/treeify/**",
    "!**/node_modules/esno/**",
    "!**/node_modules/tsx/**",
    "!**/node_modules/rimraf/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/fs-extra/**"
  ],
  "mac": {
    "icon": "resources/icons/mac/app.icns",
    "darkModeSupport": true,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/icons/mac",
        "to": "icons/mac",
        "filter": [
          "tray.png",
          "tray@2x.png"
        ]
      }
    ],
    "artifactName": "${productName}-Mac-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "resources/icons/linux/app",
    "extraResources": [
      {
        "from": "resources/icons/linux",
        "to": "icons/linux",
        "filter": [
          "tray.png",
          "256.png",
          "512.png"
        ]
      }
    ],
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  },
  "win": {
    "icon": "resources/icons/win/app.ico",
    "extraResources": [
      {
        "from": "resources/icons/win",
        "to": "icons/win",
        "filter": [
          "tray.ico",
          "tray.png"
        ]
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "publish": [
    {
      "provider": "generic",
      "url": "http://10.10.24.52:8089/electron-update"
    }
  ],
  "compression": "maximum",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "lightning",
    "runAfterFinish": true,
    "include": "installer.nsh",
    "deleteAppDataOnUninstall": true
  },
  "releaseInfo": {
    "releaseNotes": "✨ 新增Card组件并重构BackTop组件，优化样式和布局; ✨ 新增占位图标并更新页面组件样式; ✨ 添加主题工厂技能和UI/UX设计资源; ✨ 添加操作日志表格和全局返回顶部组件; ✨ 集成mock数据功能用于前后端分离开发; 🔧 将 artifacts 目录添加到代码检查工具的忽略列表; 🔧 更新构建配置文件和忽略规则; 🔧 添加 concurrently 并更新 npm scripts; 🔧 移除不再需要的 .browserslistrc 配置文件; ♻️ 重构网络状态检测钩子并更新依赖项; 🏭 **nsis:** 添加Windows安装包配置和文档; 🤖 添加 GitHub Actions 工作流以自动化发布流程; 🤖 添加 GitHub Actions 工作流配置修改"
  }
}
