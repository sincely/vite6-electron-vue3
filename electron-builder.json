{
  "appId": "ichengzhou@icloud.com",
  "asar": true,
  "asarUnpack": ["**/node_modules/sharp/**", "**/node_modules/@img/**"],
  "productName": "Crab",
  "copyright": "Copyright 2024 dyy.dongyuanwai",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "node_modules/**/*",
    "!**/node_modules/*/{CHANGELOG.md,CHANGELOG,changelog.md,CHANGELOG.txt}",
    "!**/node_modules/*/{README.md,README,readme.md,readme,Readme.md}",
    "!**/node_modules/*/{LICENSE,LICENSE.md,license.md,LICENCE,licence}",
    "!**/node_modules/*/{.eslintrc,.eslintrc.js,.eslintrc.json,.prettierrc}",
    "!**/node_modules/**/{test,tests,__tests__,spec,specs,__mocks__}/**",
    "!**/node_modules/**/{example,examples,demo,demos,sample,samples}/**",
    "!**/node_modules/**/{docs,doc,documentation,website,gh-pages}/**",
    "!**/node_modules/**/*.{ts,d.ts,map,coffee}",
    "!**/node_modules/**/.{travis.yml,nycrc,npmignore,gitignore,gitattributes}",
    "!**/node_modules/**/Makefile",
    "!**/node_modules/**/{.bin}/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/eslint*/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/stylelint*/**",
    "!**/node_modules/sass/**",
    "!**/node_modules/sharp/**",
    "!**/node_modules/png-to-ico/**"
  ],
  "extraResources": [
    {
      "from": "resources/tray",
      "to": "tray"
    },
    {
      "from": "resources/icon.png",
      "to": "icon.png"
    },
    {
      "from": "resources/icon.ico",
      "to": "icon.ico",
      "filter": ["**"]
    }
  ],
  "mac": {
    "icon": "resources/app.icns",
    "darkModeSupport": true,
    "target": ["dmg", "zip"],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "linux": {
    "icon": "resources/icon.png",
    "target": ["AppImage"],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Setup.${ext}"
  },
  "publish": [
    {
      "provider": "generic",
      "url": "http://10.10.24.52:8089/electron-update/"
    }
  ],
  "compression": "maximum",
  "electronLanguages": ["zh-CN", "en-US", "en"],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "releaseInfo": {
    "releaseNotes": "版本更新的具体内容"
  }
}
