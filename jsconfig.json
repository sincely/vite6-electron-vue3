{
  "compilerOptions": {
    "paths": {
      "@/*": ["./apps/desktop/src/renderer/*"]
    }
  },
  "include": [
    "apps/desktop/src/**/*.js",
    "apps/desktop/src/**/*.vue",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.d.ts",
    "apps/desktop/src/**/*",
    "apps/web-admin/**/*",
    "apps/website/**/*",
    "packages/shared/**/*.js",
    "packages/build-config/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "release",
    ".turbo",
    "**/.turbo"
  ]
}