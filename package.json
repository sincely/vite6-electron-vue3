{
  "name": "lightning-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Lightning monorepo: Electron desktop, Koa server, website, and update server",
  "author": "chengzhou",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=lightning",
    "dev:desktop": "turbo run dev --filter=lightning",
    "dev:server": "turbo run dev --filter=koa2-app-template",
    "dev:website": "turbo run dev --filter=lightning-website",
    "dev:update": "pnpm --filter update-server run start",
    "dev:all": "turbo run dev --filter=lightning --filter=koa2-app-template",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=lightning",
    "build:server": "turbo run build --filter=koa2-app-template",
    "build:website": "turbo run build --filter=lightning-website",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "clean": "pnpm --filter lightning run clean",
    "build-win:dev": "pnpm --filter lightning run build-win:dev",
    "build-win:test": "pnpm --filter lightning run build-win:test",
    "build-win:prod": "pnpm --filter lightning run build-win:prod",
    "build-mac:dev": "pnpm --filter lightning run build-mac:dev",
    "build-mac:test": "pnpm --filter lightning run build-mac:test",
    "build-mac:prod": "pnpm --filter lightning run build-mac:prod",
    "build-linux:dev": "pnpm --filter lightning run build-linux:dev",
    "build-linux:test": "pnpm --filter lightning run build-linux:test",
    "build-linux:prod": "pnpm --filter lightning run build-linux:prod",
    "release": "pnpm --filter lightning run release",
    "release:patch": "pnpm --filter lightning run release:patch",
    "release:minor": "pnpm --filter lightning run release:minor",
    "release:major": "pnpm --filter lightning run release:major",
    "release:server": "pnpm --filter koa2-app-template run release",
    "release:server:patch": "pnpm --filter koa2-app-template run release:patch",
    "release:server:minor": "pnpm --filter koa2-app-template run release:minor",
    "release:server:major": "pnpm --filter koa2-app-template run release:major",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "18.6.1",
    "@commitlint/config-conventional": "18.6.1",
    "@lightning/eslint-config": "workspace:*",
    "@lightning/prettier-config": "workspace:*",
    "@lightning/stylelint-config": "workspace:*",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.6.2",
    "stylelint": "16.8.2",
    "turbo": "2.11.9"
  }
}
