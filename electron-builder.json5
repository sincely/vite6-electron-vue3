/**
 * @see https://www.electron.build/configuration/configuration
 * JSON5 支持注释；此文件可按需添加行注释或块注释。
 */
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ichengzhou@icloud.com",
  "asar": true,
  "asarUnpack": [
    "dist/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/typeorm/**/*",
    "**/node_modules/app-root-path/**"
  ],
  "productName": "lightning",
  "copyright": "Copyright © 2024 dyy.dongyuanwai",
  "directories": {
    "output": "release/${version}",
    "buildResources": "resources"
  },
  "removePackageScripts": true,
  "extraResources": [],
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "!dist/**/*.map",
    "package.json",
    "node_modules/**/*",
    "!**/node_modules/*/{CHANGELOG.md,CHANGELOG,changelog.md,CHANGELOG.txt}",
    "!**/node_modules/*/{README.md,README,readme.md,readme,Readme.md}",
    "!**/node_modules/*/{LICENSE,LICENSE.md,license.md,LICENCE,licence}",
    "!**/node_modules/*/{.eslintrc,.eslintrc.js,.eslintrc.json,.prettierrc}",
    "!**/node_modules/**/{test,tests,__tests__,spec,specs,__mocks__,jest,jest.config.*}/**",
    "!**/node_modules/**/{example,examples,demo,demos,sample,samples}/**",
    "!**/node_modules/**/{docs,doc,documentation,website,gh-pages,.github}/**",
    "!**/node_modules/**/*.{ts,d.ts,map,coffee,flow,gyp}",
    "!**/node_modules/**/.{travis.yml,nycrc,npmignore,gitignore,gitattributes,editorconfig}",
    "!**/node_modules/**/Makefile",
    "!**/node_modules/**/{.bin}/**",
    "!node_modules/.bin/**",
    "node_modules/better-sqlite3/**/*",
    "node_modules/typeorm/**/*",
    "!**/node_modules/**/*.{png,jpg,jpeg,gif,svg,bmp,ico,webp,tif,tiff}",
    "!**/node_modules/**/{*.min.js.map,*.min.css.map,*.map}",
    "!**/node_modules/**/bench/**",
    "!**/node_modules/**/benchmark/**",
    "!**/node_modules/**/perf/**",
    "!**/node_modules/**/fixtures/**",
    "!**/node_modules/**/coverage/**",
    "!**/node_modules/**/CONTRIBUTING*",
    "!**/node_modules/**/HISTORY*",
    "!**/node_modules/**/AUTHORS*",
    "!**/node_modules/**/NOTICE*",
    "!**/node_modules/**/*.md",
    "!**/node_modules/**/*.txt",
    "!**/node_modules/**/package-lock.json",
    "!**/node_modules/**/yarn.lock",
    "!**/node_modules/**/.nyc_output/**",
    "!**/node_modules/**/.git/**",
    "!**/node_modules/**/.gitignore",
    "!**/node_modules/**/.npmignore",
    "!**/node_modules/**/election-builder/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/esbuild-*/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/eslint*/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/stylelint*/**",
    "!**/node_modules/postcss*/**",
    "!**/node_modules/sass/**",
    "!**/node_modules/sharp/**",
    "!**/node_modules/png-to-ico/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/vite-plugin-*/**",
    "!**/node_modules/unplugin-*/**",
    "!**/node_modules/vue-eslint-parser/**",
    "!**/node_modules/husky/**",
    "!**/node_modules/lint-staged/**",
    "!**/node_modules/@commitlint/**",
    "!**/node_modules/release-it/**",
    "!**/node_modules/@release-it/**",
    "!**/node_modules/conventional-changelog*/**",
    "!**/node_modules/inquirer/**",
    "!**/node_modules/directory-tree/**",
    "!**/node_modules/treeify/**",
    "!**/node_modules/esno/**",
    "!**/node_modules/tsx/**",
    "!**/node_modules/rimraf/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/gsap/dist/gsap.map*",
    "!**/node_modules/element-plus/docs/**",
    "!**/node_modules/element-plus/*.d.ts",
    "!**/node_modules/echarts/dist/ecStat/**"
  ],
  "mac": {
    "icon": "resources/icons/mac/app.icns",
    "darkModeSupport": true,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/icons/mac",
        "to": "icons/mac",
        "filter": [
          "tray.png",
          "tray@2x.png"
        ]
      }
    ],
    "artifactName": "${productName}-${platform}-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "resources/icons/linux/app",
    "extraResources": [
      {
        "from": "resources/icons/linux",
        "to": "icons/linux",
        "filter": [
          "tray.png",
          "256.png",
          "512.png"
        ]
      }
    ],
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  },
  "win": {
    // 代码签名
    "signAndEditExecutable": false,
    "icon": "icons/win/app.ico",
    "extraResources": [
      {
        "from": "resources/icons/win",
        "to": "icons/win",
        "filter": [
          "app.ico",
          "tray.ico",
          "tray.png"
        ]
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-${platform}-${version}-Setup.${ext}"
  },
  "publish": [
    {
      // 发布到泛型服务器
      "provider": "generic",
      // 发布到的URL
      "url": "http://10.10.24.52:8089/electron-update"
    }
  ],
  "compression": "maximum",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "nsis": {
    // 不允许一键安装
    "oneClick": false,
    // 每台机器只安装一次，不是根据用户进行安装的
    "perMachine": false,
    // 是否允许用户选择安装目录
    "allowToChangeInstallationDirectory": true,
    // 是否创建桌面快捷方式
    "createDesktopShortcut": true,
    // 是否创建开始菜单快捷方式
    "createStartMenuShortcut": true,
    // 开始菜单快捷方式名称
    "shortcutName": "lightning",
    // 是否在安装完成后运行应用程序
    "runAfterFinish": true,
    // 安装脚本文件
    "include": "./scripts/installer.nsh",
    // 是否在卸载时删除应用程序数据目录
    "deleteAppDataOnUninstall": true
  }
}