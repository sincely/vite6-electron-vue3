# JWT_SECRET --- 用于生成和验证JWT的密钥
JWT_SECRET = 'f7d623cd21149c493d7304960edaf2e10ad147528dbaf183520184fc0a0f64cb'
JWT_EXPIRES_IN= '15m'  # Access Token 过期时间 单位可以是s, m, h, d, w，例如：60s, 10m, 24h, 7d
JWT_REFRESH_EXPIRES_IN= '7d'  # Refresh Token 过期时间


# 环境变量配置
NODE_ENV=test            # 标识环境


# 数据库配置
DB_HOST=localhost         # 本地数据库地址
DB_USER=root              # 本地数据库账号
DB_PASSWORD=123456789     # 本地数据库密码
DB_NAME= electron-app     # 本地数据库名
DB_PORT=8089              # 本地数据库端口，注意：如果你在本地安装了MySQL，默认端口是3306，如果你使用了Docker容器运行MySQL，端口可能是8089，这取决于你的Docker配置。


# 环境端口
PORT=5320

# Redis是否启用
REDIS_ENABLED=true        # 是否启用 Redis


# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=8088
REDIS_PASSWORD=
REDIS_DB=0

# 数据库备份配置
BACKUP_PASSWORD=your-backup-password-here
BACKUP_MAX_COUNT=10
BACKUP_MAX_AGE_DAYS=30
