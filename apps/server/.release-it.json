{
  "git": {
    "commitMessage": "chore(server): v${version}",
    "tagName": "server-v${version}",
    "tagAnnotation": "Release server v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "requireUpstream": true,
    "requireCommits": false,
    "addUntrackedFiles": false,
    "push": true,
    "pushArgs": ["--follow-tags"]
  },
  "github": {
    "release": true,
    "releaseName": "server-v${version}",
    "tokenRef": "GITHUB_TOKEN",
    "draft": false,
    "preRelease": false
  },
  "npm": {
    "publish": false,
    "versionArgs": ["--workspaces-update=false"],
    "ignoreVersion": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "init",
            "section": "🎉 init"
          },
          {
            "type": "feat",
            "section": "✨ Features"
          },
          {
            "type": "fix",
            "section": "🐞 Bug Fixes"
          },
          {
            "type": "perf",
            "section": "⚡ Performance Improvements"
          },
          {
            "type": "revert",
            "section": "💫 Reverts"
          },
          {
            "type": "docs",
            "section": "📝 Documentation"
          },
          {
            "type": "style",
            "section": "🎨 Styles"
          },
          {
            "type": "chore",
            "section": "🔧 Chores"
          },
          {
            "type": "refactor",
            "section": "♻️ Code Refactoring"
          },
          {
            "type": "test",
            "section": "🧪 Tests"
          },
          {
            "type": "build",
            "section": "🏭 Build System"
          },
          {
            "type": "ci",
            "section": "🤖 Continuous Integration"
          },
          {
            "type": "release",
            "section": "🚀 Releases"
          }
        ]
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to the server will be documented in this file.\n",
      "gitRawCommitsOpts": {
        "path": "."
      },
      "commitsOpts": {
        "path": "."
      },
      "ignoreRecommendedBump": false,
      "strictSemVer": true
    }
  },
  "hooks": {
    "before:init": ["pnpm run lint"],
    "after:release": "echo 'Server release server-v${version} completed successfully!'"
  }
}
