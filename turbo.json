{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["VITE_*", "NODE_ENV", "DEBUG"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "lint:check": {},
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
